{
  "name": "indiadits-backend",
  "version": "1.0.0",
  "description": "Backend API for IndiaDits Real Estate Listing Platform",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
