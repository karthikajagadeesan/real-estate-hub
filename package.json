{
  "name": "indiadits-root",
  "version": "1.0.0",
  "private": true,
  "description": "IndiaDits Real Estate Platform — Root Workspace",
  "scripts": {
    "dev": "node start-dev.js",
    "start": "node start-dev.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:db:push": "npx prisma db push --schema=backend/prisma/schema.prisma",
    "prisma:seed": "npm run prisma:seed --prefix backend",
    "prisma:studio": "npx prisma studio --schema=backend/prisma/schema.prisma",
    "studio": "npx prisma studio --schema=backend/prisma/schema.prisma",
    "setup": "npm run install:all && npm run prisma:generate && npm run prisma:db:push && npm run prisma:seed"
  }
}
